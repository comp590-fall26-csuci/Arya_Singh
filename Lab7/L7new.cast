[2294.176648, "o", "ansible-playbook -i Lab7/hosts.ini Lab7/playbook.yml --syntax-check"]
[2295.584233, "o", "\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Cnano Lab7/playbook.yml\u001b[K"]
[2295.972619, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b/usr/local/bin/gitea generate secret JWT_SECRET"]
[2296.144943, "o", "\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Csudo -u git env USER=git HOME=/home/git GITEA_WORK_DIR=/var/lib/gitea /usr/local/bin/gitea web --config /etc/gitea/app.ini"]
[2296.307784, "o", "\u001b[A\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bsystemctl stop gitea\u001b[K\r\n"]
[2296.30783, "o", "\r\u001b[K\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[2296.910012, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bgrep -q '^JWT_SECRET = .' /etc/gitea/app.ini && echo \"JWT secret found\""]
[2297.442013, "o", "\u001b[A\r\u001b]0;arya@debian: ~/Arya_Singh\u0007\u001b[01;32marya@debian\u001b[00m:\u001b[01;34m~/Arya_Singh\u001b[00m$ \u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\\[oauth2\\]' /etc/gitea/app.ini && echo \"OAuth2 section\r\n"]
[2297.442081, "o", "\r\u001b[C\u001b[C"]
