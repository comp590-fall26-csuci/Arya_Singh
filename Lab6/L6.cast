[2569.540815, "o", "\r\n     3\t- name: Configure the Lab6 Debian VM\r\n     4\t  hosts: lab6\r\n     5\t  gather_facts: true\r\n     6\t\r\n     7\t"]
[2569.540879, "o", " tasks:\r\n     8\t    - name: Install Asciinema with pipx\r\n     9\t      ansible.builtin.command:\r\n    10\t        cmd: pipx install asciinema\r\n    11\t        creates: \"{{ ansible_env.Home }}/.local/bin\r\n    12\t\r\n    13\t    - name: Install Apache\r\n    14\t      become: true\r\n    15\t      ansible.builtin.apt:\r\n    16\t        name: apache2\r\n    17\t        state: present\r\n    18\t        update_cache: true\r\n    19\t\r\n    20\t    - name: Enable and start Apache2\r\n    21\t      become: true\r\n    22\t      ansible.builtin.service:\r\n    23\t        name: apache2\r\n    24\t        state: started\r\n    25\t        enabled: true\r\n    26\t\r\n    27\t    - name: Display completion message\r\n    28\t      ansible.builtin.debug:\r\n    29\t        msg: \"Lab6 is complete. Asciinema is installed with pipx and Apache2 is enabled and running.\"\r\n    30\tEOF\r\n    31\t\r\n\u001b[?2004h\u001b]0;arya@debian: ~/Arya_Singh\u0007\u001b[01;32marya@debian\u001b[00m:\u001b[01;34m~/Arya_Singh\u001b[00m$ "]
