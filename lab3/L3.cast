[5891.352359, "o", "  start\r\n    \u001b[2mmadrun start\u001b[22m\r\n  test\r\n    \u001b[2mmadrun test\u001b[22m\r\n"]
[5891.352471, "o", "available via `\u001b[34mnpm run-script\u001b[39m`:\r\n  start:dev\r\n    \u001b[2mmadrun start:dev\u001b[22m\r\n"]
[5891.352815, "o", "  build:start\r\n"]
[5891.353354, "o", "    \u001b[2mmadrun build:start\u001b[22m\r\n  build:start:dev\r\n    \u001b[2mmadrun build:start:dev\u001b[22m\r\n  lint:all\r\n"]
[5891.353574, "o", "    \u001b[2mmadrun lint:all\u001b[22m\r\n  lint\r\n"]
[5891.353801, "o", "    \u001b[2mmadrun lint\u001b[22m\r\n  lint:progress\r\n    \u001b[2mmadrun lint:progress\u001b[22m\r\n  watch:lint\r\n    \u001b[2mmadrun watch:lint\u001b[22m\r\n"]
[5891.354003, "o", "  fresh:lint\r\n    \u001b[2mmadrun fresh:lint\u001b[22m\r\n  lint:fresh\r\n    \u001b[2mmadrun lint:fresh\u001b[22m\r\n  fix:lint\r\n    \u001b[2mmadrun fix:lint\u001b[22m\r\n  lint:stream\r\n"]
[5891.354109, "o", "    \u001b[2mmadrun lint:stream\u001b[22m\r\n  test:e2e\r\n    \u001b[2mmadrun test:e2e\u001b[22m\r\n  test:e2e:menu\r\n    \u001b[2mmadrun test:e2e:menu\u001b[22m\r\n"]
[5891.354272, "o", "  test:e2e:client\r\n"]
[5891.354529, "o", "    \u001b[2mmadrun test:e2e:client\u001b[22m\r\n  test:client\r\n    \u001b[2mmadrun test:client\u001b[22m\r\n"]
[5891.35478, "o", "  test:server\r\n    \u001b[2mmadrun test:server\u001b[22m\r\n  wisdom\r\n"]
[5891.35496, "o", "    \u001b[2mmadrun wisdom\u001b[22m\r\n  wisdom:type\r\n    \u001b[2mmadrun wisdom:type\u001b[22m\r\n  coverage\r\n    \u001b[2mmadrun coverage\u001b[22m\r\n  coverage:report\r\n    \u001b[2mmadrun coverage:report\u001b[22m\r\n  report\r\n"]
[5891.355135, "o", "    \u001b[2mmadrun report\u001b[22m\r\n  6to5\r\n    \u001b[2mmadrun 6to5\u001b[22m\r\n  6to5:client\r\n    \u001b[2mmadrun 6to5:client\u001b[22m\r\n  6to5:client:dev\r\n"]
[5891.355416, "o", "    \u001b[2mmadrun 6to5:client:dev\u001b[22m\r\n  watch:client\r\n    \u001b[2mmadrun watch:client\u001b[22m\r\n  watch:client:dev\r\n    \u001b[2mmadrun watch:client:dev\u001b[22m\r\n  watch:server\r\n    \u001b[2mmadrun watch:server\u001b[22m\r\n  watch:test\r\n"]
[5891.355471, "o", "    \u001b[2mmadrun watch:test\u001b[22m\r\n  watch:test:client\r\n"]
[5891.35587, "o", "    \u001b[2mmadrun watch:test:client\u001b[22m\r\n  watch:test:server\r\n    \u001b[2mmadrun watch:test:server\u001b[22m\r\n  watch:coverage\r\n    \u001b[2mmadrun watch:coverage\u001b[22m\r\n  watch:fix:lint\r\n    \u001b[2mmadrun watch:fix:lint\u001b[22m\r\n  build\r\n    \u001b[2mmadrun build\u001b[22m\r\n  build:dev\r\n    \u001b[2mmadrun build:dev\u001b[22m\r\n  build:client\r\n    \u001b[2mmadrun build:client\u001b[22m\r\n  build:client:dev\r\n    \u001b[2mmadrun build:client:dev\u001b[22m\r\n  heroku-postbuild\r\n    \u001b[2mmadrun heroku-postbuild\u001b[22m\r\n"]
