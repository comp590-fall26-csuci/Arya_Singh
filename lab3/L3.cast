[5145.351077, "o", "\r\nadded 1694 packages, and audited 1695 packages in 1m\r\n"]
[5145.351975, "o", "\r\n"]
[5145.352284, "o", "459 packages are looking for funding\r\n  run `npm fund` for details\r\n"]
[5145.388516, "o", "\r\n\u001b[31m\u001b[1m30\u001b[22m\u001b[39m vulnerabilities (23 \u001b[33m\u001b[1mmoderate\u001b[22m\u001b[39m, 2 \u001b[31m\u001b[1mhigh\u001b[22m\u001b[39m, 5 \u001b[35m\u001b[1mcritical\u001b[22m\u001b[39m)\r\n\r\nTo address issues that do not require attention, run:\r\n  npm audit fix\r\n\r\nTo address all issues possible (including breaking changes), run:\r\n  npm audit fix --force\r\n\r\nSome issues need review, and may require choosing\r\na different dependency.\r\n\r\nRun `npm audit` for details.\r\n"]
