[4031.675448, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 7.2                                          passwords.sh                                                    \u001b[1;119H\u001b(B\u001b[m\r\u001b[29d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[29;16H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[29;61H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\r\u001b[30d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[30;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy"]
[4031.678083, "o", "\r\u001b[2d\u001b[36m#!/bin/bash\r\u001b[4d\u001b[39m\u001b(B\u001b[mPASSWORD_FILE\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"passwords.txt\"\r\u001b[5d\u001b[39m\u001b(B\u001b[mOUTPUT_DIRECTORY\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"password_files\"\r\u001b[7d\u001b(B\u001b[0m\u001b[32mif\u001b[39m\u001b(B\u001b[m \u001b[32m[[\u001b[39m\u001b(B\u001b[m \u001b[32m!\u001b(B\u001b[0;1m\u001b[35m -f\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$PASSWORD_FILE\"\u001b[39m\u001b(B\u001b[m \u001b[32m]];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[8;9H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Error: $PASSWORD_FILE was not found.\"\u001b[9;9H\u001b(B\u001b[0m\u001b[32mexit\u001b[39m\u001b(B\u001b[m 1\r\u001b[10d\u001b[32mfi\r\u001b[12d\u001b(B\u001b[0;1m\u001b[34mmkdir\u001b[35m -p\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$OUTPUT_DIRECTORY\"\r\u001b[14d\u001b[39m\u001b(B\u001b[mcounter\u001b[32m=\u001b[39m\u001b(B\u001b[m1\r\u001b[16d\u001b[32mwhile\u001b[39m\u001b(B\u001b[m IFS\u001b[32m=\u001b[39m\u001b(B\u001b[m \u001b[32mread\u001b(B\u001b[0;1m\u001b[35m -r\u001b[39m\u001b(B\u001b[m password\u001b[32m;\u001b[39m\u001b(B\u001b[m \u001b[32mdo\u001b[17;9Hif\u001b[39m\u001b(B\u001b[m \u001b[32m[[\u001b(B\u001b[0;1m\u001b[35m -n\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[39m\u001b(B\u001b[m \u001b[32m]];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[18;17H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[19;17H\u001b[34mprintf\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m'%s\\n'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[39m\u001b(B\u001b[m \u001b[32m>\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"OUTPUT_DIRECTORY/password_${counter}.txt\"\u001b[20;17H\u001b(B\u001b[0m\u001b[32m((\u001b[39m\u001b(B\u001b[mcounter++\u001b[32m))\u001b[21;9Hfi\r\u001b[22ddone\u001b[39m\u001b(B\u001b[m \u001b[32m<\u001b[39m\u001b(B\u001b[m \u001b[32m<(\u001b(B\u001b[0;1m\u001b[34msort\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$PASSWORD_FILE\"\u001b(B\u001b[0m\u001b[32m)\r\u001b[24d\u001b(B\u001b[0;1m\u001b[34mecho\r\u001b[25decho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Created $((counter-1)) password files.\"\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
