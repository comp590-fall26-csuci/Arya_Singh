[3507.063623, "o", "\r\u001b[2d\u001b[36m#!/bin/bash\r\u001b[4d\u001b[39m\u001b(B\u001b[mPASSWORD_FILE\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"passwords.txt\"\r\u001b[5d\u001b[39m\u001b(B\u001b[mOUTPUT_DIRECTORY\u001b[32m=\u001b(B\u001b[0;1m\u001b[33m\"password_files\"\r\u001b[7d\u001b(B\u001b[0m\u001b[32mif\u001b[39m\u001b(B\u001b[m \u001b[32m[[\u001b[39m\u001b(B\u001b[m \u001b[32m!\u001b(B\u001b[0;1m\u001b[35m -f\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$PASSWORD_FILE\"\u001b[39m\u001b(B\u001b[m \u001b[32m]];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[8;9H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Error: $PASSWORD_FILE was not found.\"\u001b[9;9H\u001b(B\u001b[0m\u001b[32mexit\u001b[39m\u001b(B\u001b[m 1\r\u001b[10d\u001b[32mfi\r\u001b[12d\u001b(B\u001b[0;1m\u001b[34mmkdir\u001b[35m -p\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$OUTPUT_DIRECTORY\"\r\u001b[14d\u001b[39m\u001b(B\u001b[mcounter\u001b[32m=\u001b[39m\u001b(B\u001b[m1\r\u001b[16d\u001b[32mwhile\u001b[39m\u001b(B\u001b[m IFS\u001b[32m=\u001b[39m\u001b(B\u001b[m \u001b[32mread\u001b(B\u001b[0;1m\u001b[35m -r\u001b[39m\u001b(B\u001b[m password\u001b[32m;\u001b[39m\u001b(B\u001b[m \u001b[32mdo\u001b[17;9Hif\u001b[39m\u001b(B\u001b[m \u001b[32m[[\u001b(B\u001b[0;1m\u001b[35m -n\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[39m\u001b(B\u001b[m \u001b[32m]];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[18;17H\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[19;17H"]
[3507.063734, "o", "\u001b[34mprintf\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m'%s\\n'\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"$password\"\u001b[39m\u001b(B\u001b[m \u001b[32m>\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"OUTPUT_DIRECTORY/password_${counter}.txt\"\u001b[20;17H\u001b(B\u001b[0m\u001b[32m((\u001b[39m\u001b(B\u001b[mcounter++\u001b[32m))\u001b[21;9Hfi\r\u001b[22ddone\u001b[39m\u001b(B\u001b[m \u001b[32m<\u001b[39m\u001b(B\u001b[m \u001b[32m<(\u001b(B\u001b[0;1m\u001b[34msort\u001b[33m\"$PASSWORD_FILE\"\u001b(B\u001b[0m\u001b[32m)\r\u001b[24d\u001b(B\u001b[0;1m\u001b[34mecho\r\u001b[25decho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Created $((counter-1)) password files.\"\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
